# Copia este archivo a .env (no versionado) antes de `docker compose up`.
# ADMIN_KEY es obligatoria: usa una clave larga y aleatoria, nunca la dejes vacía.
ADMIN_KEY=

# Opcional: por defecto apunta al servicio `db` de docker compose.
# DB_URL=postgresql+psycopg://barberbook:barberbook@db:5432/barberbook
